{
  "manifest_version": 3,
  "name": "Image to PDF / CBZ Downloader",
  "version": "2.0.0",
  "description": "Select images on a webpage and download them as a combined PDF or CBZ comic archive.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
